# ---------------------------------------------------------------------------
# Mazlum / TransforMew .gitignore
#
# Ship: source code, data/mazlum/model.npz (weights) and
#       submissions/mazlum.tar.gz (Kaggle bundle). Everything else stays local.
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# --- Competition assets (competition-use only, never committed) ---
the-pokemon-company-ptcg-ai-battle-challenge-playground.zip
pokemon/
vendor/
cg/
*.pdf
*_Card_Data_*.csv
*.so
*.dll
*.dylib

# --- Replays, logs and experiment outputs ---
replays/
results/
logs/
build/

# --- Datasets: only the trained weights are kept ---
data/*
!data/mazlum/
data/mazlum/*
!data/mazlum/model.npz
dataset.npz
dagger.npz
_arena_candidate.npz
*.npz
!data/mazlum/model.npz

# --- JSON: manifests, episode metadata, metrics, bot meta ---
*.json

# --- Submission bundles: only the Mazlum package ships ---
submissions/*
!submissions/mazlum.tar.gz
!submissions/README.md
!submissions/kaggle_submissions.csv
!submissions/kaggle_submissions.png

# --- Large archives / local scratch data (never commit) ---
*.zip

# --- Model weights / large generated artifacts (never commit) ---
*.pt
*.pth
*.bin
*.onnx
*.pkl
*.npy
agents/*/data/
agents/*/models/
agents/*/submissions/
